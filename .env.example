# Copy to .env (never commit .env). All values are optional.

# Enables the AI second opinion and drafting. Without it the rules engine runs alone (degraded mode).
ANTHROPIC_API_KEY=
# auto | off
DCC_AI_MODE=auto
# Defaults to claude-sonnet-5-5
DCC_AI_MODEL=
# Password for the seeded demo users (used on first run only)
DCC_DEMO_PASSWORD=demo123
POSTGRES_PASSWORD=dcc
